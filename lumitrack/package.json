{
  "name": "lumitrack",
  "version": "0.4.1",
  "description": "Visualizador de audio en barras de luz con búsqueda por YouTube. Uso personal, no comercial.",
  "author": "Lumitrack",
  "type": "module",
  "main": "desktop/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicolasfernandezriesen/Lumitrack.git"
  },
  "scripts": {
    "start": "node start.js",
    "desktop": "electron .",
    "server": "node server/index.js",
    "dev": "node --watch server/index.js",
    "setup": "node setup.js",
    "dist": "electron-builder --win nsis --config ../installer/electron-builder.yml --publish never",
    "dist:publish": "electron-builder --win nsis --config ../installer/electron-builder.yml --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^4.19.2",
    "ytmusic-api": "^5.3.1"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  }
}
